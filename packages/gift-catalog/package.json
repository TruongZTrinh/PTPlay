{
  "name": "@ptplay/gift-catalog",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Provider-agnostic TikTok LIVE gift catalogue importer, browser, and gift identity resolution for PTPlay",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "gifts:sync": "node scripts/sync-gifts.mjs",
    "gifts:icons": "node scripts/fetch-icon-zip.mjs",
    "gifts:browse": "node scripts/browse-gifts.mjs",
    "gifts:observe": "node scripts/import-observed.mjs",
    "test": "node --test tests/catalog.test.mjs && tsx --test tests/service.test.mjs"
  },
  "engines": { "node": ">=20" }
}
